cabal-version:      3.0
name:               nucleo
version:            0.1.0.0
build-type:         Simple
synopsis:           La cáscara: junta motor y reglas y habla con el cliente por socket

executable nucleo
  main-is:          Main.hs
  other-modules:    Agente
  hs-source-dirs:   .
  default-language: Haskell2010
  build-depends:    base, motor, reglas, aeson, bytestring, text, network, directory, filepath, process, containers
  -- -rtsopts deja medir y ajustar la recolección de basura sin recompilar
  -- (por ejemplo, +RTS -s). A la escala del mapa completo la recolección se
  -- lleva cerca del 40 % del tiempo; agrandar la zona de asignación (-A) no lo
  -- mejora, porque lo que más asigna es la proyección diaria de la vista.
  ghc-options:      -Wall -Werror -threaded -rtsopts
