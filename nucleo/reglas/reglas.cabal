cabal-version:      3.0
name:               reglas
version:            0.1.0.0
build-type:         Simple
synopsis:           Reglas del juego purépecha

library
  exposed-modules:  Reglas.Base
                    Reglas.Estado
                    Reglas.Constantes
                    Reglas.Comando
                    Reglas.Formulas
                    Reglas.Grupos
                    Reglas.Edificios
                    Reglas.Produccion
                    Reglas.Sistemas
                    Reglas.Escenario
                    Reglas.Juego
  hs-source-dirs:   src
  default-language: Haskell2010
  default-extensions:
    StrictData OverloadedStrings TypeFamilies
    DeriveGeneric DeriveAnyClass LambdaCase
  build-depends:    base, motor, aeson, containers, text
  ghc-options:      -Wall -Werror -Wincomplete-patterns

test-suite spec
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  default-language: Haskell2010
  default-extensions: StrictData OverloadedStrings TypeFamilies
  build-depends:    base, motor, reglas, containers, hspec, QuickCheck, aeson, text, bytestring
  ghc-options:      -Wall
